[book]
# Relative paths below are resolved against this file's directory, so the
# project can be moved. Keep them relative to avoid leaking a home directory.
source = "../source.epub"
source_dir = "src"
work = "work"
output = "../out/translated.epub"
title = "中文书名"
source_title = "Original English Title"
author = "Author Name"
translator = "AI 辅助翻译"
language = "zh-CN"
publisher = ""

[extract]
text_dir = "OEBPS/Text"
extensions = [".html"]
skip = []
# Elements kept byte-identical during extraction, as "tag" or "tag.class".
# Use this for code blocks a publisher styles without <pre>.
protect_blocks = []
# Chunk preset: "large" (2600 words, no cap), "small" (1200/40),
# "mini" (1000/25) or "tiny" (600/20). Only "large" is the default.
# Decide it before `extract`; an existing project cannot switch.
profile = "large"
words_per_chunk = 2600
max_segments_per_chunk = 0
require_latin = true

[typography]
spacing = true
css = "default"
stylesheet = "OEBPS/Styles/stylesheet.css"
protect_tags = ["pre", "code", "kbd", "samp", "var", "tt"]

[translate]
# "inline" (default): the translator copies paired inline markers.
# "aligned": the translator writes one fluent TEXT plus one SPAN per paired
# span; the tool restores the markers by exact substring matching.
mode = "inline"


[toc]
contents_file = "contents.html"

[toc.labels]
# Package-level labels that are not listed in contents.html.
# "copyright" = "版权页"
# "contents" = "目录"
# "dedication" = "献词"
# "preface" = "前言"
# "acknowledgments" = "致谢"
# "about this book" = "关于本书"
# "about the author" = "关于作者"
# "about the cover illustration" = "关于封面插图"
# "index" = "索引"
